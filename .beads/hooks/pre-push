#!/bin/bash
# Global pre-push secret scan: gitleaks over exactly the commits about to leave
# this machine. Blocks the push on any finding. Bypass: git push --no-verify.
# Chains to the repo-local pre-push hook afterward (core.hooksPath shadows it).
set -u

# Non-interactive/GUI/IDE pushes often run with a PATH that lacks Homebrew, so
# resolve gitleaks explicitly. Without this the bare `gitleaks` call exits 127
# and reads as "secrets found", blocking EVERY push.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

Z=0000000000000000000000000000000000000000
stdin=$(cat)

chain() {
  # chain repo-local hook (husky, commit-gate, etc.) with the original stdin.
  # NOTE: --git-dir, not --git-path hooks/... — the latter resolves through
  # core.hooksPath and would exec this hook recursively.
  local lh; lh="$(git rev-parse --git-dir)/hooks/pre-push"
  [ -x "$lh" ] && exec "$lh" "$@" <<< "$stdin"
  exit 0
}

if ! command -v gitleaks >/dev/null 2>&1; then
  # Fail OPEN, but loudly — a missing tool must not block every push (that just
  # trains a reflexive --no-verify, which then bypasses real scans too).
  echo "⚠ gitleaks not found — pre-push secret scan SKIPPED. Install: brew install gitleaks" >&2
  chain "$@"
fi

while read -r lref lsha rref rsha; do
  [ -z "${lsha:-}" ] && continue
  [ "$lsha" = "$Z" ] && continue            # deleting a remote ref — nothing outgoing
  if [ "$rsha" = "$Z" ]; then
    opts="$lsha --not --remotes"            # new branch: scan commits no remote has
  else
    opts="$rsha..$lsha"
  fi
  if ! gitleaks git --no-banner --redact --log-opts="$opts" .; then
    echo "" >&2
    echo "PUSH BLOCKED: gitleaks found secrets in outgoing commits ($lref)." >&2
    echo "Fix (rewrite the offending commits), or bypass ONLY if false positive:" >&2
    echo "  git push --no-verify" >&2
    exit 1
  fi
done <<< "$stdin"

chain "$@"

# --- BEGIN BEADS INTEGRATION v1.2.2 ---
# This section is managed by beads. Do not remove these markers.
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  case "$_bd_timeout" in
    *[!0-9]*|'') _bd_timeout_invalid=1 ;;
    *[1-9]*) _bd_timeout_invalid=0 ;;
    *) _bd_timeout_invalid=1 ;;
  esac
  if [ "$_bd_timeout_invalid" -eq 1 ]; then
    echo >&2 "beads: invalid BEADS_HOOK_TIMEOUT; using 300 seconds"
    _bd_timeout=300
  fi
  _bd_timeout_backend=none
  _bd_timeout_command=
  for _bd_timeout_candidate in timeout gtimeout; do
    if command -v "$_bd_timeout_candidate" >/dev/null 2>&1; then
      if _bd_timeout_version="$("$_bd_timeout_candidate" --version 2>/dev/null)"; then
        case "$_bd_timeout_version" in
          "timeout (GNU coreutils) "*) _bd_timeout_command=$_bd_timeout_candidate; break ;;
        esac
      fi
    fi
  done
  if [ -n "$_bd_timeout_command" ]; then
    _bd_timeout_backend=coreutils
    if "$_bd_timeout_command" -- "$_bd_timeout" bd hooks run pre-push "$@"; then
      _bd_exit=0
    else
      _bd_exit=$?
    fi
  elif command -v perl >/dev/null 2>&1; then
    _bd_timeout_backend=perl
    if perl -e 'alarm shift; exec @ARGV' -- "$_bd_timeout" bd hooks run pre-push "$@"; then
      _bd_exit=0
    else
      _bd_exit=$?
    fi
  else
    echo >&2 "beads: hook 'pre-push' running without timeout; install coreutils or perl to enable BEADS_HOOK_TIMEOUT"
    if bd hooks run pre-push "$@"; then
      _bd_exit=0
    else
      _bd_exit=$?
    fi
  fi
  if { [ "$_bd_timeout_backend" = coreutils ] && [ "$_bd_exit" -eq 124 ]; } || { [ "$_bd_timeout_backend" = perl ] && [ "$_bd_exit" -eq 142 ]; }; then
    echo >&2 "beads: hook 'pre-push' timed out after ${_bd_timeout}s — continuing without beads"
    _bd_exit=0
  fi
  if [ "$_bd_exit" -eq 3 ]; then
    echo >&2 "beads: database not initialized — skipping hook 'pre-push'"
    _bd_exit=0
  fi
  if [ "$_bd_exit" -ne 0 ]; then exit "$_bd_exit"; fi
fi
# --- END BEADS INTEGRATION v1.2.2 ---
